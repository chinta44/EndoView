<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.serenegiant.widget.AspectRatioTextureView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/liveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="内視鏡映像 (独自プロトコル機)"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <com.chinta44.endoview.GridOverlayView
            android:id="@+id/gridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/freezeImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="フリーズ画像"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#88000000"
            android:padding="16dp"
            android:text="USB内視鏡を接続してください"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/recordTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="64dp"
            android:layout_marginEnd="10dp"
            android:background="#66CC0000"
            android:padding="6dp"
            android:text="● 00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/debugLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="#B9F6CA"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLogToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="#88000000"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="ログ"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/deviceInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSaveDest"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="保存先"
            android:padding="9dp"
            android:src="@drawable/ic_folder" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sideBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="回転"
            android:enabled="false"
            android:padding="12dp"
            android:src="@drawable/ic_rotate" />

        <ImageButton
            android:id="@+id/btnMirror"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="反転"
            android:padding="12dp"
            android:src="@drawable/ic_flip" />

        <ImageButton
            android:id="@+id/btnGrid"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="グリッド"
            android:padding="12dp"
            android:src="@drawable/ic_grid" />

        <ImageButton
            android:id="@+id/btnResolution"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="解像度"
            android:enabled="false"
            android:padding="12dp"
            android:src="@drawable/ic_aspect" />

        <ImageButton
            android:id="@+id/btnControls"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="調整"
            android:enabled="false"
            android:padding="12dp"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingEnd="56dp"
        android:paddingBottom="16dp"
        android:paddingStart="12dp">

        <ImageButton
            android:id="@+id/btnFreeze"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="フリーズ"
            android:enabled="false"
            android:padding="15dp"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btnPhoto"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bg_shutter"
            android:contentDescription="写真"
            android:enabled="false"
            android:padding="21dp"
            android:src="@drawable/ic_photo" />

        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="録画"
            android:enabled="false"
            android:padding="15dp"
            android:src="@drawable/ic_video" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDevices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:background="#37474F"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="🔌 デバイスを選んで接続"
        android:textColor="#FFFFFF" />

    <ScrollView
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F21A1A1A"
        android:maxHeight="330dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/presetDefault"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="標準"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/presetDark"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="暗所・配管"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/presetMetal"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="金属"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/presetBoard"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="基板・文字"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slidersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnResetControls"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="調整をリセット"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnExposureAuto"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="露出をオートに戻す"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
